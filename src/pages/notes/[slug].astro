---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const response = await fetch(
    "https://marcoslopezm.github.io/SS/notes-ss.json",
  );
  const notesData = await response.json();

  return [
    {
      params: { slug: "notes-ss" },
      props: { data: notesData },
    },
  ];
}

const { data } = Astro.props;
const { title, description, subject, chapters, hasFull, pdfUrl } = data;

let sectionIndex = 0;
let chapterIndex = 0;
const numberedChapters = (chapters ?? []).map((ch) => {
  if (ch.isChapter === true) {
    sectionIndex++;
    chapterIndex = 0;
    return { ...ch, number: `${sectionIndex}.` };
  } else {
    chapterIndex++;
    return { ...ch, number: `${sectionIndex}.${chapterIndex}` };
  }
});

const totalChapters = numberedChapters.filter(
  (ch) => ch.isChapter === true,
).length;
---

<BaseLayout title={title} description={description}>
  <!-- Breadcrumb -->
  <nav class="mb-8 flex items-center gap-2 font-mono text-xs text-zinc-600">
    <a href="/notes/" class="transition-colors hover:text-zinc-400">Documents</a
    >
    <span>/</span>
    <span class="text-zinc-400">{title}</span>
  </nav>

  <!-- Header row -->
  <div
    class="mb-10 flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="min-w-0">
      <span
        class="mb-3 inline-block rounded-full px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-widest uppercase"
        style="background: oklch(0.78 0.13 80 / 0.1); color: var(--color-accent); box-shadow: inset 0 0 0 1px oklch(0.78 0.13 80 / 0.2);"
      >
        {subject}
      </span>
      <h1
        class="font-display text-3xl leading-tight font-semibold tracking-tight text-white sm:text-4xl"
      >
        {title}
      </h1>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400">
        {description}
      </p>
    </div>

    <!-- Full PDF download button -->
    {
      hasFull && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex shrink-0 items-center gap-2 self-start rounded-lg border px-4 py-2.5 text-sm font-medium transition-all duration-200 hover:brightness-110"
          style="background: oklch(0.78 0.13 80 / 0.1); border-color: oklch(0.78 0.13 80 / 0.25); color: var(--color-accent);"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            />
          </svg>
          Full document
        </a>
      )
    }
  </div>

  <!-- Chapter list -->
  {
    numberedChapters.length > 0 ? (
      <div>
        <div class="mb-1 flex items-center justify-between text-emerald-300">
          <h2 class="font-mono text-[9pt] font-semibold tracking-widest uppercase">
            Outline
          </h2>
          <span class="font-mono text-[9pt] font-semibold tracking-widest uppercase">
            {totalChapters} {totalChapters == 1 ? "chapter" : "chapters"}
          </span>
        </div>
        <p class="mb-4 font-mono text-[9pt] text-zinc-600 italic">
          Click any chapter to open it ↗
        </p>

        <ol
          style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:1px;"
          role="list"
        >
          {numberedChapters.map((ch) =>
            ch.isChapter === true ? (
              <li role="listitem" class="pt-5 pb-1 first:pt-2">
                <a
                  href={ch.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center gap-3 px-3 transition-opacity duration-150 hover:opacity-80"
                >
                  <span class="font-mono text-xs font-bold text-zinc-500">
                    {ch.number}
                  </span>
                  <span
                    class="font-mono text-xs font-bold tracking-widest uppercase"
                    style="color: var(--color-accent);"
                    role="heading"
                    aria-level={3}
                  >
                    {ch.title}
                  </span>
                </a>
              </li>
            ) : (
              <li role="listitem">
                <a
                  href={ch.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:border-l-accent! hover:bg-accent-dim/5 group flex items-baseline gap-3 rounded-md px-3 py-2.5 pl-8 transition-all duration-150"
                  style="border-left: 2px solid transparent;"
                >
                  <span class="w-8 shrink-0 text-right font-mono text-xs text-zinc-600 transition-colors group-hover:text-zinc-400">
                    {ch.number}
                  </span>
                  <span class="flex min-w-0 flex-1 items-baseline gap-1 overflow-hidden">
                    <span class="truncate font-medium text-zinc-300 transition-colors group-hover:text-white">
                      {ch.title}
                    </span>
                    <span
                      class="mx-1 flex-1 shrink border-b border-dashed border-zinc-800 transition-colors group-hover:border-zinc-600"
                      aria-hidden="true"
                      style="min-width: 1rem; position: relative; top: -3px;"
                    />
                  </span>
                  <span
                    class="shrink-0 font-mono text-xs text-zinc-600 transition-all duration-150 group-hover:translate-x-0.5 group-hover:text-emerald-400"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </li>
            ),
          )}
        </ol>
      </div>
    ) : (
      <p class="font-mono text-xs text-zinc-700">
        No individual chapters available.
      </p>
    )
  }
</BaseLayout>
