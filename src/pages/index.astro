---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Home";
---

<BaseLayout title={pageTitle}>
  <section class="py-20">
    <p
      class="mb-3 font-mono text-sm tracking-widest"
      style="color: var(--color-accent);"
    >
      Physics · UNAM
    </p>
    <h1
      class="font-display text-5xl leading-tight font-semibold tracking-tight text-white sm:text-6xl"
    >
      Marcos López Merino
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-zinc-400">
      Physics student at Facultad de Ciencias, UNAM. Working on my undergraduate
      thesis.
    </p>

    <!-- Social links -->
    <div class="mt-8 flex items-center gap-3">
      <a
        href="https://github.com/MarcosLopezM"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium text-zinc-400 transition-all duration-200 hover:text-zinc-100"
        style="border-color: var(--color-border); background: var(--color-surface);"
      >
        <svg
          class="h-4 w-4"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            fill-rule="evenodd"
            d="M12.006 2a9.847 9.847 0 0 0-6.484 2.44 10.32 10.32 0 0 0-3.393 6.17 10.48 10.48 0 0 0 1.317 6.955 10.045 10.045 0 0 0 5.4 4.418c.504.095.683-.223.683-.494 0-.245-.01-1.052-.014-1.908-2.78.62-3.366-1.21-3.366-1.21a2.711 2.711 0 0 0-1.11-1.5c-.907-.637.07-.621.07-.621.317.044.62.163.885.346.266.183.487.426.647.71.135.253.318.476.538.655a2.079 2.079 0 0 0 2.37.196c.045-.52.27-1.006.635-1.37-2.219-.259-4.554-1.138-4.554-5.07a4.022 4.022 0 0 1 1.031-2.75 3.77 3.77 0 0 1 .096-2.713s.839-.275 2.749 1.05a9.26 9.26 0 0 1 5.004 0c1.906-1.325 2.74-1.05 2.74-1.05.37.858.406 1.828.101 2.713a4.017 4.017 0 0 1 1.029 2.75c0 3.939-2.339 4.805-4.564 5.058a2.471 2.471 0 0 1 .679 1.897c0 1.372-.012 2.477-.012 2.814 0 .272.18.592.687.492a10.05 10.05 0 0 0 5.388-4.421 10.473 10.473 0 0 0 1.313-6.948 10.32 10.32 0 0 0-3.39-6.165A9.847 9.847 0 0 0 12.007 2Z"
            clip-rule="evenodd"></path>
        </svg>
        GitHub
      </a>

      <a
        href="mailto:marcoslm@ciencias.unam.mx"
        class="flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium text-zinc-400 transition-all duration-200 hover:text-zinc-100"
        style="border-color: var(--color-border); background: var(--color-surface);"
      >
        <svg
          class="h-4 w-4"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            d="M2.038 5.61A2.01 2.01 0 0 0 2 6v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6c0-.12-.01-.238-.03-.352l-.866.65-7.89 6.032a2 2 0 0 1-2.429 0L2.884 6.288l-.846-.677Z"
          ></path>
          <path
            d="M20.677 4.117A1.996 1.996 0 0 0 20 4H4c-.225 0-.44.037-.642.105l.758.607L12 10.742 19.9 4.7l.777-.583Z"
          ></path>
        </svg>
        Email
      </a>
    </div>
  </section>
</BaseLayout>
