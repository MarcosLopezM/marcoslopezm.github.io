---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  id: string;
  title: string;
  description: string;
  subject: string;
  tags?: string[];
  previewImage?: ImageMetadata;
  chaptersCount?: number;
}

const { id, title, description, subject, tags, previewImage, chaptersCount } =
  Astro.props;
---

<a
  href={`/notes/${id}/`}
  class="note-card group relative flex flex-col overflow-hidden rounded-xl border transition-colors duration-300"
  style="background: var(--color-surface); border-color: var(--color-border);"
  data-subject={subject}
>
  <div
    class="relative h-44 overflow-hidden"
    style="background: var(--color-surface-raised);"
  >
    {
      previewImage ? (
        <Image
          src={previewImage}
          alt={`Preview of ${title}`}
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <svg
            class="h-14 w-14"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="0.8"
            style="color: var(--color-border);"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
        </div>
      )
    }

    <div
      class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100"
      style="background: oklch(0 0 0 / 0.15);"
    >
      <span
        class="rounded-full px-3 py-1 text-xs font-medium"
        style="background: var(--color-accent); color: var(--color-accent);"
      >
        View
      </span>
    </div>
  </div>

  <!-- Card body -->
  <div class="flex flex-1 flex-col p-4">
    <!-- Subject badge + chapter count -->
    <div class="mb-2 flex items-center gap-2">
      <span
        class="rounded-full px-2 py-0.5 font-mono text-[10px] font-medium tracking-widest uppercase"
        style="background: color-mix(in oklch, var(--color-accent) 10%, transparent); color: var(--color-accent); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-accent) 20%, transparent);"
      >
        {subject}
      </span>
      {
        (chaptersCount ?? 0) > 0 && (
          <span class="font-mono text-[10px] text-zinc-600">
            {chaptersCount} ch.
          </span>
        )
      }
    </div>

    <p
      class="group-hover:text-accent text-sm leading-snug font-semibold text-zinc-100 transition-colors duration-200"
    >
      {title}
    </p>

    <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-zinc-500">
      {description}
    </p>

    {
      tags && tags.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1 pt-3">
          {tags.slice(0, 3).map((tag) => (
            <span
              class="rounded px-1.5 py-0.5 font-mono text-[10px] text-zinc-600"
              style="background: oklch(1 0 0 / 0.04); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.06);"
            >
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>
</a>
