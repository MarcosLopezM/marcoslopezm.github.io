---
const links = [
  { href: `/`, label: "Home" },
  { href: `/misc-docs/`, label: "Documents" },
];
---

<nav class="bg-surface border-accent/20 sticky top-0 z-50 border-b">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="text-accent">Marcos López Merino</a>
    <ul class="flex list-none gap-6">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="hover:text-accent text-gray-300 transition-colors duration-200"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
