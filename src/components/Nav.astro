---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/notes/", label: "Documents" },
];

function isActive(href: string) {
  if (href == "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header>
  <nav
    class="sticky top-0 z-50 border-b"
    style="background: oklch(0.09 0.01 260 / 0.85); backdrop-filter: blur(12px); border-color: oklch(1 0 0 / 0.07);"
  >
    <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
      <a
        href="/"
        class="font-display text-base font-semibold tracking-tight transition-colors duration-200"
        style="color: var(--color-accent);"
      >
        Marcos López Merino
      </a>

      <ul class="flex list-none items-center gap-1">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class="rounded-md px-3 py-1.5 text-sm font-medium transition-colors duration-200"
                style={
                  isActive(href)
                    ? " color: var(--color-accent); background: color-mix(in oklch, var(--color-accent) 10%, transparent);"
                    : "color: oklch(0.71 0 0);"
                }
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
