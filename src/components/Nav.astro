---
const { pathname } = Astro.url;
const links = [
  { href: "/", label: "Home" },
  { href: "/notes/", label: "Documents" },
];

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname.startsWith(href);
}
---

<header>
  <nav
    class="sticky top-0 right-0 left-0 z-50 flex items-center border-b border-white/[0.07] bg-[oklch(0.09_0.01_260/0.85)] backdrop-blur-md"
  >
    <div
      class="mx-auto flex w-full max-w-4xl items-center justify-between px-6 py-5"
    >
      <a
        href="/"
        class="font-display text-accent text-lg font-semibold tracking-tight transition-opacity duration-200 hover:opacity-80"
      >
        Marcos López Merino
      </a>

      <ul class="flex list-none items-center gap-4">
        {
          links.map(({ href, label }) => (
            <li>
              <a
                href={href}
                class={[
                  "font-mono text-[0.75rem] font-medium tracking-widest uppercase transition-colors duration-200",
                  "focus-visible:ring-accent focus-visible:ring-2 focus-visible:ring-offset-1 focus-visible:outline-none",
                  isActive(href)
                    ? "text-accent"
                    : "hover:text-accent text-[oklch(0.71_0_0)]",
                ].join(" ")}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
